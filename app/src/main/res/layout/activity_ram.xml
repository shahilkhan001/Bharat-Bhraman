<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TITLE -->
            <TextView
                android:text="Ram Mandir"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- SUBTITLE -->
            <TextView
                android:text="Ayodhya, Uttar Pradesh"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- DESCRIPTION -->
            <TextView
                android:text="Ram Mandir in Ayodhya is a grand temple dedicated to Lord Ram, believed to be his birthplace. It symbolizes faith, devotion, and India's rich cultural heritage."
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- IMAGE 1 -->
            <ImageView
                android:id="@+id/img1"
                android:src="@drawable/ay1"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:text="• The grand architecture of Ram Mandir showcases intricate carvings and traditional Nagara style design."
                android:textSize="16sp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- IMAGE 2 -->
            <ImageView
                android:id="@+id/img2"
                android:src="@drawable/ay4"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:text="• The temple परिसर attracts thousands of devotees daily who come for darshan and spiritual experience."
                android:textSize="16sp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- IMAGE 3 -->
            <ImageView
                android:id="@+id/img3"
                android:src="@drawable/ay3"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:text="• The temple looks especially beautiful during evening lighting and religious ceremonies."
                android:textSize="16sp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- IMAGE 4 -->
            <ImageView
                android:id="@+id/img4"
                android:src="@drawable/ay4"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:text="• Ayodhya city around the temple offers ghats, temples, and a peaceful spiritual environment."
                android:textSize="16sp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- TRAVEL INFO -->
            <TextView
                android:text="Travel Info"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="• Ayodhya is well connected by rail and road.\n• The nearest airport is Maharishi Valmiki International Airport.\n• Local transport includes autos and taxis."
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- ENTRY INFO -->
            <TextView
                android:text="Entry Info"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="• Entry to Ram Mandir is free.\n• Security checks are strict.\n• Mobile phones may be restricted inside temple premises."
                android:textSize="16sp"
                android:layout_marginBottom="50dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

    <!-- FLOAT BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        app:srcCompat="@android:drawable/ic_menu_compass"/>

</RelativeLayout>