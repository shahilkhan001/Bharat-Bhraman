<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@drawable/back">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uttar Pradesh"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/textUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to the virtual world of Uttar Pradesh. The heartland of India, it is a land of rich heritage, vibrant culture, and historic wonders. From the iconic Taj Mahal in Agra to the sacred ghats of Varanasi, every corner reflects timeless beauty and spirituality. It is also the divine birthplace of Lord Ram in Ayodhya and Lord Krishna in Mathura. With its grand monuments, cultural traditions, and deep-rooted history, Uttar Pradesh truly represents the soul of India." android:textSize="14sp"
            android:textColor="#DD070707"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnSpeak"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:text="🔊"
                android:textSize="22sp"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/btnPause"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:text="⏸"
                android:textSize="22sp"/>

        </LinearLayout>


        <!-- ITINERARY SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRAVEL ITINERARY"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3E2C1C"
            android:layout_marginBottom="10dp"/>

        <!-- Image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/up_map"
        android:scaleType="centerCrop"
        android:layout_marginBottom="12dp"/>

        <!-- Table -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:background="#F5E6CC"
            android:padding="8dp"
            android:layout_marginBottom="20dp">

            <!-- Header Row -->
            <TableRow>
                <TextView
                    android:text="Place"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:textColor="#3E2C1C"/>

                <TextView
                    android:text="Days"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:textColor="#3E2C1C"/>
            </TableRow>

            <!-- Row 1 -->
            <TableRow>
                <TextView
                    android:text="Agra (Taj Mahal)"
                    android:padding="8dp"/>

                <TextView
                    android:text="1 Day"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Row 2 -->
            <TableRow>
                <TextView
                    android:text="Varanasi"
                    android:padding="8dp"/>

                <TextView
                    android:text="2 Days"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Row 3 -->
            <TableRow>
                <TextView
                    android:text="Ayodhya"
                    android:padding="8dp"/>

                <TextView
                    android:text="2 Days"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Row 4 -->
            <TableRow>
                <TextView
                    android:text="Mathura  Vrindavan"
                    android:padding="8dp"/>

                <TextView
                    android:text="2 Days"
                    android:padding="8dp"/>
            </TableRow>

            <!-- Row 5 -->
            <TableRow>
                <TextView
                    android:text="Lucknow"
                    android:padding="8dp"/>

                <TextView
                    android:text="1-2 Days"
                    android:padding="8dp"/>
            </TableRow>

        </TableLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp"
            android:padding="12dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                android:backgroundTint="#E9CE93">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INDIAN MONUMENTS"
                        android:textSize="18sp"
                        android:textColor="#3E2C1C"
                        android:layout_marginBottom="16dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <!-- CARD 1 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:id="@+id/cardTaj"
                            android:layout_columnWeight="1"
                            android:layout_margin="8dp"
                            app:cardCornerRadius="20dp"
                            android:backgroundTint="#F5E6CC">

                            <LinearLayout
                                android:orientation="vertical"
                                android:padding="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:src="@drawable/taj"
                                    android:layout_width="match_parent"
                                    android:layout_height="130dp"
                                    android:scaleType="centerCrop"
                                    android:layout_marginBottom="8dp"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Taj Mahal"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:textColor="#3E2C1C"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Agra, UP"
                                    android:textSize="12sp"
                                    android:textColor="#7A6A58"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- CARD 2 -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardKashi"
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="8dp"
                            app:cardCornerRadius="20dp"
                            android:backgroundTint="#F5E6CC">

                            <LinearLayout
                                android:orientation="vertical"
                                android:padding="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:src="@drawable/kv"
                                    android:layout_width="match_parent"
                                    android:layout_height="130dp"
                                    android:scaleType="centerCrop"
                                    android:layout_marginBottom="8dp"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Kashi Vishwanath"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:textColor="#3E2C1C"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Varanasi, UP"
                                    android:textSize="12sp"
                                    android:textColor="#7A6A58"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- CARD 3 -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardRam"
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="8dp"
                            app:cardCornerRadius="20dp"
                            android:backgroundTint="#F5E6CC">

                            <LinearLayout
                                android:orientation="vertical"
                                android:padding="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:src="@drawable/ram"
                                    android:layout_width="wrap_content"
                                    android:layout_height="130dp"
                                    android:scaleType="centerCrop"
                                    android:layout_marginBottom="8dp"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Ayodhya"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:textColor="#3E2C1C"/>

                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Ayodhya, UP"
                                    android:textSize="12sp"
                                    android:textColor="#7A6A58"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </GridLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>