<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/back"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/logo"
            android:scaleType="centerInside"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Bharat Bhraman"
            android:textColor="#3E2723"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- VIDEO -->
    <VideoView
        android:id="@+id/introVideo"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/introVideo"
        app:layout_constraintBottom_toTopOf="@id/floatingButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONTENT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Bharat Bhraman 🇮🇳"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:paddingBottom="10dp"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore India’s most famous destinations, learn their history, and plan your journey easily."
                android:textSize="16sp"
                android:textColor="#4E342E"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="16dp"/>

            <!-- Section Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Features"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:paddingBottom="10dp"/>

            <!-- Features -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎤 Voice-to-voice translation for seamless interaction"
                android:textSize="15sp"
                android:paddingBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Scan monuments to get instant information"
                android:textSize="15sp"
                android:paddingBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗺️ Explore states with dedicated sections"
                android:textSize="15sp"
                android:paddingBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬 Watch video glimpses &amp; travel guides"
                android:textSize="15sp"
                android:paddingBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏛️ View monument history &amp; 360° details"
                android:textSize="15sp"
                android:paddingBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧳 Plan trips efficiently with all info in one place"
                android:textSize="15sp"/>

        </LinearLayout>
    </ScrollView>

    <!-- FLOATING BUTTONS -->
    <LinearLayout
        android:id="@+id/floatingButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Scan"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/buttonbg"
                app:backgroundTint="@null"
                app:icon="@drawable/camera"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Translate"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/buttonbg"
                app:backgroundTint="@null"
                app:icon="@drawable/mic"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>