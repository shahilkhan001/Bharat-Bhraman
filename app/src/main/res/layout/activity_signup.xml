<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <TextView
        android:id="@+id/titleSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:fontFamily="serif"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nameCard"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="#F3E2C7"
        app:strokeColor="#3E2723"
        app:strokeWidth="2dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/titleSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="50dp">

        <EditText
            android:id="@+id/fullName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Full Name"
            android:paddingStart="20dp"
            android:gravity="center_vertical"
            android:textColor="#3E2723"
            android:textColorHint="#6D4C41"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dobCard"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="#F3E2C7"
        app:strokeColor="#3E2723"
        app:strokeWidth="2dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/nameCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="18dp">

        <EditText
            android:id="@+id/dob"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Date of Birth"
            android:focusable="false"
            android:clickable="true"
            android:paddingStart="20dp"
            android:gravity="center_vertical"
            android:textColor="#3E2723"
            android:textColorHint="#6D4C41"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emailCardSignup"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="#F3E2C7"
        app:strokeColor="#3E2723"
        app:strokeWidth="2dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/dobCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="18dp">

        <EditText
            android:id="@+id/emailSignup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Email ID"
            android:paddingStart="20dp"
            android:gravity="center_vertical"
            android:textColor="#3E2723"
            android:textColorHint="#6D4C41"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/passwordCardSignup"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="#F3E2C7"
        app:strokeColor="#3E2723"
        app:strokeWidth="2dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/emailCardSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="18dp">

        <EditText
            android:id="@+id/passwordSignup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:gravity="center_vertical"
            android:textColor="#3E2723"
            android:textColorHint="#6D4C41"/>
    </com.google.android.material.card.MaterialCardView>

    <CheckBox
        android:id="@+id/showPassword1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Password"
        android:textColor="#3E2723"
        app:layout_constraintTop_toBottomOf="@id/passwordCardSignup"
        app:layout_constraintStart_toStartOf="@id/passwordCardSignup"
        android:layout_marginStart="40dp"
        android:layout_marginTop="2dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/confirmPasswordCard"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="#F3E2C7"
        app:strokeColor="#3E2723"
        app:strokeWidth="2dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/showPassword1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/confirmPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:gravity="center_vertical"
            android:textColor="#3E2723"
            android:textColorHint="#6D4C41"/>
    </com.google.android.material.card.MaterialCardView>

    <CheckBox
        android:id="@+id/showPassword2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Password"
        android:textColor="#3E2723"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordCard"
        app:layout_constraintStart_toStartOf="@id/confirmPasswordCard"
        android:layout_marginStart="40dp"
        android:layout_marginTop="2dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/signupCard"
        android:layout_width="220dp"
        android:layout_height="50dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/showPassword2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signupBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="SIGN UP"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/buttonbg"
            app:backgroundTint="@null"/>
    </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/loginRedirect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login"
            android:textColor="#3E2723"
            android:textSize="18sp"
            android:fontFamily="serif"
            app:layout_constraintTop_toBottomOf="@id/signupCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
