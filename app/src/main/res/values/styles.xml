<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ImageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">250dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
    <style name="ImageCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">250dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <style name="ImageInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="DescText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#111827</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
</resources>